<Project Sdk="Microsoft.NET.Sdk">
  <!-- Copyright © 2026 Amazon.com and Affiliates. Licensed under MIT-0. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OrdersApi</RootNamespace>
  </PropertyGroup>

  <!--
    Lives in 00-shared/ so it sorts ahead of the variants that reference it —
    the directory listing is the reading order. Layout mirrors a variant:
    <dir>/src/<ProjectName>/.

    This holds ALL the application code. A variant directory contains only its
    template, its samconfig and its Program.cs, which is what makes "same code,
    different stacks" literally rather than approximately true.

    NO trim or AOT properties here on purpose. The AOT variants publish with
    TrimMode full, so this assembly is trimmed along with theirs.
  -->

  <ItemGroup>
    <!-- The only package reference: the DynamoDB client OrderRepository uses. -->
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="4.*" />
  </ItemGroup>

</Project>
